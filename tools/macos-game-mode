#!/usr/bin/env python3
"""Prepare an SiliconShaders macOS app bundle for automatic Game Mode in native fullscreen.

Run after jpackage creates a local app image, before distributing or starting it.
Developer ID releases should use --sign-identity with their normal signing identity.
The JAR alone cannot opt an unrelated launcher's Java process into Game Mode.
"""
import argparse
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import tempfile
import time


def atomic_write(path, data):
    mode = path.stat().st_mode & 0o777
    fd, name = tempfile.mkstemp(prefix=path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('app', type=Path, help='SiliconShaders .app produced by jpackage')
    parser.add_argument('--game-dir', type=Path, help='Existing Minecraft game directory; selects native instead of exclusive fullscreen')
    parser.add_argument('--sign-identity', default='-', help='Signing identity; default is an ad-hoc signature for local app images')
    args = parser.parse_args()
    if os.uname().sysname != 'Darwin':
        parser.error('This packaging step requires macOS.')
    app = args.app.resolve()
    info_path = app / 'Contents/Info.plist'
    if app.suffix != '.app' or not info_path.is_file():
        parser.error('Expected a macOS .app bundle with Contents/Info.plist.')
    info = plistlib.loads(info_path.read_bytes())
    executable = app / 'Contents/MacOS' / info['CFBundleExecutable']
    processes = subprocess.check_output(['ps', '-A', '-o', 'comm='], text=True).splitlines()
    if str(executable) in (line.strip() for line in processes):
        parser.error('Close this app before updating its Game Mode metadata.')
    config_path = app / 'Contents/app' / (info['CFBundleExecutable'] + '.cfg')
    if not config_path.is_file():
        parser.error('Expected the jpackage launcher configuration in Contents/app.')
    config = config_path.read_text()
    if '[JavaOptions]' not in config:
        parser.error('The launcher configuration has no JavaOptions section.')
    options = None
    if args.game_dir:
        options = args.game_dir.resolve() / 'options.txt'
        if not options.is_file():
            parser.error('--game-dir must contain an existing Minecraft options.txt.')
    keys = {'LSApplicationCategoryType': 'public.app-category.games',
            'LSSupportsGameMode': True, 'GCSupportsGameMode': True}
    backup_dir = app.parent / (app.name + '.siliconshaders-game-mode-backup')
    backup_dir.mkdir(exist_ok=True)
    backup = backup_dir / 'Info.plist'
    if not backup.exists():
        shutil.copy2(info_path, backup)
    if any(info.get(key) != value for key, value in keys.items()):
        info.update(keys)
        atomic_write(info_path, plistlib.dumps(info, sort_keys=False))
    config_backup = backup_dir / config_path.name
    if not config_backup.exists():
        shutil.copy2(config_path, config_backup)
    lines = [line for line in config.splitlines() if not line.startswith('java-options=-Dsiliconshaders.macos.appId=')]
    for i, line in enumerate(lines):
        if line == '[JavaOptions]':
            lines.insert(i + 1, 'java-options=-Dsiliconshaders.macos.appId=' + info['CFBundleIdentifier'])
            break
    updated_config = '\n'.join(lines) + '\n'
    if updated_config != config:
        atomic_write(config_path, updated_config.encode())
    if options:
        original = options.read_text()
        lines = original.splitlines()
        native = ['exclusiveFullscreen:false' if line.startswith('exclusiveFullscreen:') else line for line in lines]
        if not any(line.startswith('exclusiveFullscreen:') for line in lines):
            native.append('exclusiveFullscreen:false')
        if native != lines:
            option_backup = options.with_name('options.siliconshaders-before-game-mode.txt')
            if not option_backup.exists():
                shutil.copy2(options, option_backup)
            atomic_write(options, ('\n'.join(native) + '\n').encode())
    subprocess.run(['plutil', '-lint', str(info_path)], check=True)
    subprocess.run(['codesign', '--force', '--sign', args.sign_identity,
                    '--preserve-metadata=entitlements,requirements,flags', str(app)], check=True)
    subprocess.run(['codesign', '--verify', '--deep', '--strict', str(app)], check=True)
    register = Path('/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister')
    subprocess.run([str(register), '-f', str(app)], check=True)
    # Launch Services and Spotlight cache app categories separately. Updating Info.plist alone
    # leaves the old Utilities category in Spotlight until the bundle itself is reimported.
    app.touch()
    subprocess.run(['mdimport', '-i', str(app)], check=True)
    category = ''
    for attempt in range(25):
        category = subprocess.check_output(['mdls', '-raw', '-name', 'kMDItemAppStoreCategoryType', str(app)], text=True).strip().strip('"')
        if category == 'public.app-category.games':
            break
        time.sleep(0.2)
    if category == 'public.app-category.games':
        print('Spotlight also recognizes this bundle as a game.')
    else:
        print('Spotlight import requested; its category is not updated yet (indexing may be disabled).')
    print('SiliconShaders app registered as a game with Game Mode support.')
    print('Game Mode can activate automatically in macOS native fullscreen on Apple silicon (macOS 14+).')
    print('macOS retains a player’s manual Game Mode off setting; this tool does not override it.')


if __name__ == '__main__':
    main()
