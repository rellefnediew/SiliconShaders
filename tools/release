#!/bin/sh
# Build the mod and package it, locally (nothing is uploaded anywhere):
# - dist/siliconshaders-VERSION.jar, the single-jar install: the Metal mod with its natives inside. Put it in the mods folder;
#   this build runs without Sodium.
# - dist/siliconshaders-VERSION.zip: siliconshaders-VERSION/{siliconshaders-VERSION.jar, README.txt, LICENSE, NOTICE}, the same jar byte for
#   byte (README.txt is RELEASE-README.txt with the version filled in).
# Usage: tools/release
set -eu
cd "$(dirname "$0")/.."
die() { echo "$*" >&2; exit 1; }
version=$(sed -n "s/^version = '\(.*\)'$/\1/p" metal/build.gradle)
[ -n "$version" ] || die "No version in metal/build.gradle."
./gradlew :metal:build -q --console=plain
jar=metal/build/libs/SiliconShaders-$version.jar
[ -f "$jar" ] || die "The build made no $jar."
name=siliconshaders-$version
mkdir -p dist
cp "$jar" "dist/siliconshaders-$version.jar"
rm -rf "dist/$name" "dist/$name.zip"
mkdir -p "dist/$name"
cp "dist/siliconshaders-$version.jar" "dist/$name/siliconshaders-$version.jar"
cp LICENSE NOTICE "dist/$name/"
sed "s/@VERSION@/$version/g" RELEASE-README.txt > "dist/$name/README.txt"
(cd dist && zip -qrX "$name.zip" "$name")
echo "dist/$name.zip"
